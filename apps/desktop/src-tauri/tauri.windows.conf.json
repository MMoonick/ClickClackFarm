        "alwaysOnTop": true,
        "fullscreen": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
